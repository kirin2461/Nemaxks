{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping (baseUrl удалён — в TS 6.0 опция убрана; paths работает относительно tsconfig) */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Явный список @types: не подключаем автоматически всё из node_modules/@types
       (в CI @types/aria-query приходит битым с зеркала → TS2688) */
    "types": ["node", "react", "react-dom", "qrcode.react"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

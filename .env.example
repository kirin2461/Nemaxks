# ===========================================
# Nemaxks Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# Список синхронизирован с реально читаемыми переменными
# (backend/*.go, jarvis, docker-compose.yml).

# ===========================================
# REQUIRED - Core Configuration
# ===========================================

# Database connection string (PostgreSQL)
# Format: postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://username:password@localhost:5432/nemaxks?sslmode=disable

# PostgreSQL credentials for docker-compose (обязательны, дефолтов нет)
POSTGRES_USER=nemaxks
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nemaxks

# JWT Secret Key - MUST be changed in production!
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server port
PORT=8000

# Gin framework mode: release (production) / debug (development)
GIN_MODE=release

# ===========================================
# REQUIRED FOR PRODUCTION - Security
# ===========================================

# Frontend URL for CORS configuration
FRONTEND_URL=https://your-frontend-domain.com

# Comma-separated list of allowed CORS origins (HTTP API, main.go)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Comma-separated list of allowed WebSocket origins (websocket.go)
ALLOWED_ORIGINS=https://your-frontend-domain.com

# Enforce HTTPS redirects/security headers: true/false
ENFORCE_HTTPS=false

# ===========================================
# OPTIONAL - Redis Configuration
# ===========================================

# Redis URL for caching and sessions
# Leave empty to disable Redis features
REDIS_URL=redis://localhost:6379

# Redis password (используется и в docker-compose: redis-server --requirepass)
REDIS_PASSWORD=change-me-redis-password

# ===========================================
# OPTIONAL - LiveKit Voice/Video
# ===========================================

# LiveKit server configuration for voice/video calls
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-livekit-server.com

# ===========================================
# OPTIONAL - WebRTC (ICE servers, Placeholder.go)
# ===========================================

# Comma-separated STUN servers (default: public google/cloudflare)
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated TURN/TURNS urls
TURN_URLS=turn:turn.example.com:3478

# TURN credentials
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# ===========================================
# OPTIONAL - Payments (YooKassa)
# ===========================================

YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key

# ===========================================
# OPTIONAL - Email (SMTP)
# ===========================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=noreply@example.com

# ===========================================
# OPTIONAL - AI Integration
# ===========================================

# DeepSeek AI API
DEEPSEEK_API_KEY=your-deepseek-api-key

# HuggingFace API
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Jarvis: лимит токенов на запрос (число)
JARVIS_TOKEN_LIMIT=4096

# ===========================================
# OPTIONAL - Telegram Integration
# ===========================================

# Telegram Bot for notifications
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username

# ===========================================
# FRONTEND (Vite build-time)
# ===========================================

VITE_API_URL=http://localhost:8000

# ===========================================
# SECURITY (читается кодом, production-важно)
# ===========================================

# Список доверенных прокси для Gin SetTrustedProxies (CIDR через запятую).
# Укажите CIDR вашего ingress/reverse-proxy — иначе rate-limit и YooKassa IP-check
# будут видеть IP прокси вместо клиента.
# TRUSTED_PROXIES=10.0.0.0/8

# Разрешить тестовые лицензионные ключи (только для dev; в prod НЕ включать)
# ALLOW_TEST_LICENSE_KEY=false

# Секрет для верификации Telegram webhook (X-Telegram-Bot-Api-Secret-Token)
# TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Проверка IP-allowlist YooKassa для платёжных webhook (default: включено; false — отключить)
# YOOKASSA_WEBHOOK_IP_CHECK=true
